# ============================================================
# GTA 6 SHORTS ENGINE - ENVIRONMENT CONFIGURATION
# ============================================================

# 1. Google Gemini AI API Key (Required for AI Viral Curation)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 2. YouTube Data API v3 Key (Optional for scouting, fallback to yt-dlp scraping)
# Get key from Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_API_KEY=AIzaSyYourYouTubeDataApiKeyHere

# 3. YouTube OAuth2 Upload Credentials (Required for automated publishing)
# Setup via `python setup_oauth.py`
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=1//04your_refresh_token_here

# 4. Engine Thresholds & Defaults
MIN_VIEWERS=2000
MIN_VIRAL_SCORE=8
DEFAULT_CLIP_DURATION=48
TARGET_GAME="Grand Theft Auto VI"
GAME_KEYWORDS="gta 6,gta vi,grand theft auto 6,grand theft auto vi,gta online,gta v,gta"

# 5. Publishing Settings
UPLOAD_PRIVACY_STATUS=public    # Options: public, unlisted, private
AUTO_UPLOAD=true                # Set to false to only render without uploading
MAX_SHORTS_PER_RUN=2            # Max clips to generate per scheduled run

# 6. Whisper Model Size (tiny, base, small, medium)
# 'base' is ideal for fast CPU execution in GitHub Actions
WHISPER_MODEL=base
